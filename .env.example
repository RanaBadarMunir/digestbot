# Copy to .env.local for local development. Never commit real values.

# PostgreSQL connection string (Neon). Leave empty locally to use the embedded PGlite database in .data/
DATABASE_URL=

# Session signing secret, at least 32 random characters (required in production)
AUTH_SECRET=

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Comma-separated emails that become admins when they sign up / log in
ADMIN_EMAILS=

# Public base URL (used in share links and emails), e.g. https://digestbot.vercel.app
APP_URL=

# Optional: Google Gemini API key for AI summaries (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Resend API key for emailing digests (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=DigestBot <onboarding@resend.dev>
